# Start: turns_declare_independence_ref's output.sav (France, Autumn 1600, turn 109, War of Independence
# declared; the Tories hold Montreal) with the calendar moved to Autumn 1849 (head.year 1849, autumn 1),
# English Roanoke (coastal, pop 2) handed to France (three founding-coastal ports, so no @WARN1 is due), and
# every French unit without orders fortified (land, orders 6) or sentried (ships, orders 1).
# End of turn 109: a REF wave near Roanoke and Tory fights near Guadeloupe (nested pump). Spring 1850: the
# wartime calendar end, FUN_3844_0442 raw 58629-58676 (`!(0x5382 & 0x10)`, year 0x73a = 1850, any war state):
# @RETIRING2 ("War-weary Continental Congress sues for peace! ...", estate = the most populous French colony:
# Quebec) right after the calendar step, before the Indian pass (port_bugs.md #1387), the retire chain without the @RETIRE confirm (F10 score report, exploits screen, Hall of Fame; the
# harness starts from an empty HALLFAME.DAT), then @SCORED (port_bugs.md #1232); "Keep playing anyway." (row 1)
# returns to the map with calendar_latch (0x5382 |= 0x10) set and the war still on (no endgame latch).
# Turn 110 (Spring to Autumn 1850, still year 1850): the calendar block is off, so no second @RETIRING2;
# the REF fights on.
key space                # end turn 109 (Autumn 1849)
wait 30
key Return               # Royal Expeditionary Force lands near Roanoke (nested pump)
wait 10
key Return               # nested pump
wait 10
key Return               # Rebel colonists CAPTURED by the Tory (nested pump)
wait 10
key Return               # Tories defeat Rebel Colonists near Guadeloupe (nested pump)
wait 10
key Return               # nested pump
wait 10
key Return               # Rebel colonists CAPTURED by the Tory (nested pump)
wait 10
key Return               # Tories defeat Rebel Colonists near Guadeloupe (nested pump)
wait 10
key Return               # @RETIRING2: War-weary Continental Congress sues for peace (estate near Quebec)
wait 10
key Return               # F10 score report
wait 10
key Return               # exploits screen
wait 10
key Return               # Hall of Fame
wait 10
key Down                 # @SCORED: bar to row 1
key Return               # "Keep playing anyway.": the day goes on (DS:0x53c2 = 1)
wait 10
key Return               # Iroquois gift of 11 Cotton to Port au Prince
wait 10
key Return               # Tupi gift of 16 Furs to Quebec
wait 10
shot                     # Spring 1850
key s                    # Caravel #71 (woken by the fighting) sentried
wait 10
key s                    # unit #72 in Quebec sentried
wait 10
key s                    # Caravel #73 sentried
wait 10
key s                    # unit #84 in Quebec sentried
wait 10
key space                # end turn 110 (Spring 1850)
wait 30
key Return               # Royal Expeditionary Force lands near Roanoke (nested pump)
wait 10
key Return               # nested pump
wait 10
key Return               # Rebel colonists CAPTURED by the Tory (nested pump)
wait 10
key Return               # Tories defeat Rebel Colonists near Guadeloupe (nested pump)
wait 10
key Return               # Tupi @INDIANCOMMENT ("pleased to see the prosperity ..."): a !bVar6 visit with no demand
wait 10
key Return               # Tupi ask Quebec for food: row 0 "I'm sorry, we gave at the office."
wait 10
key Return               # SoL in Port au Prince 71%: Continue turn
wait 10
key Return               # SoL in Martinique 71%: Continue turn
wait 10
key Return               # SoL in Guadeloupe 71%: Continue turn
wait 10
shot                     # Autumn 1850, no second @RETIRING2; Caravel #71 asks for orders
