# A Founding Father joins at end of turn and the next one is picked.
# Start: turns_spring_1600_events' output (France, Spring 1600, turn 108) re-saved once, with France's
# next_founding_father = 16 (Pocahontas) and liberty_bells_pool = 1000, just under the elect threshold
# founding_fathers_bells_needed (FUN_4345_0982: human, difficulty 4 -> base 14*8 = 112, year > 1599
# +50% -> 168, 5 fathers elected -> 6*168+1 = 1009), and every French unit with no orders / go-to /
# pioneer job on sentry. Turn 108's ~65 bells cross the threshold: Pocahontas joins (her elect effect
# zeroes France's alarm_by_player and tribe friction), the congress picker is answered with
# Benjamin Franklin (row 3), and the turn after runs with the new pick locked in (two turns).
# England is at war with France: it captures Guadeloupe and its units wake the sentries near Quebec.
key space                # end turn 108 (Spring 1600)
wait 30
key Return               # Colonization Help: Time Scale
wait 65
                         #  wagon train captured (no outcome popup: #1464/#1465)
key Return               # French colonists captured by the English
wait 6
key Return               # English march into Guadeloupe, 90 gold plundered
wait 6
key Return               # Pocahontas has joined the Continental Congress
wait 6
key Return               # congress screen: skip the animation
wait 6
key Return               # congress screen: (second key)
wait 6
key Return               # congress screen: close
wait 6
key Return               # Colonizopedia entry for Pocahontas: close
wait 6
key Down                 # congress picker (next father): Ferdinand Magellan
key Down                 # John Paul Jones
key Down                 # Benjamin Franklin
key Return               # Franklin becomes next_founding_father (19)
wait 6
key Return               # SoL Quebec 60% (Continue turn)
wait 30
key Return               # price of Cigars rises; the Caravel reaching Europe opens the Europe screen
wait 6
key Escape               # leave the Europe screen
wait 6
key s                    # turn 109 (Autumn 1600): sentry the eleven units woken next to the English
wait 3
key s
wait 3
key s
wait 3
key s
wait 3
key s
wait 3
key s
wait 3
key s
wait 3
key s
wait 3
key s
wait 3
key s
wait 3
key s                    # last one: End of Turn
wait 3
key space                # end turn 109
wait 40
key Return               # the Iroquois bring 16 Ore to Port au Prince
wait 10
key Return               # English warnings to leave New England and an English victory over French Pioneers
wait 10                 # near Guadeloupe (nested in the AI turn; spare presses fall between popups)
key Return
wait 10
key Return
wait 10
key Return
wait 10
key Return               # King raises tax to 27%: Kiss pinky ring
wait 10
key Return               # SoL Port au Prince 12% (Continue turn)
wait 10
key Return               # SoL Martinique 51% (Continue turn)
wait 10
key Return               # new cargo of Horses at Montreal (Continue turn)
wait 10
key Return               # @LUMBER "Quebec has run out of lumber" (Continue turn): Phase K before L, no longer
wait 10                  #  suppressed by an earlier status write in the tick (#1461)
