# Start: turns_spring_1600_events' input.sav (France, autumn 1599, turn 107; map_unit_orders' output).
# Fixture edits (sav_json): every French map unit without orders or on go-to is sentried (so Space
# ends each turn), Combat Analysis off (the English attack on Guadeloupe in the AI turn would
# otherwise hold an extra modal). Quebec: colonist 5 (statesman) made a carpenter, lumber 60,
# hammers 50 on the Lumber Mill (52). Montreal: project Artillery (raw code 42: 192 hammers,
# 40 tools), hammers 192, tools 34, colonist 6 (statesman) made a blacksmith, ore 50.
# Two turns. Turn 1: the carpenter's 3 hammers take Quebec to 53 and the Lumber Mill completes
# (@BUILT notice); Montreal's blacksmith makes 3 tools (37), still short of 40: @NEEDTOOLS
# (40 needed, 37 on hand). Turn 2: tools reach 40, the Artillery completes (hammers 0, tools 0,
# a new Artillery on the Montreal tile) with its notice.
key space                  # end the turn (autumn 1599)
wait 300
key Return                 # @NEEDTOOLS: Artillery in Montreal needs 40 tools, 37 available: Continue turn
wait 60
key Return                 # Quebec colony produces Lumber Mill: Continue turn
wait 60
key Return                 # King increases military spending: Regulars added to the REF
wait 60
key Return                 # price of Coats in La Rochelle rises
wait 60
shot
key s                      # sentry Scout 77 (spring 1600): nothing left to move
wait 30
key space                  # end the turn (spring 1600)
wait 300
key Return                 # Colonization Help: Time Scale (two turns per year from now on)
wait 300
key Return                 # English defeat French Colonists near Guadeloupe
wait 100
key Return                 # French wagon train captured by the English
wait 60
key Return                 # French colonists captured by the English
wait 60
key Return                 # English march into Guadeloupe, 90$ plundered
wait 60
key Return                 # Montreal colony produces Artillery: Continue turn
wait 60
key Return                 # price of Cigars in La Rochelle rises
wait 60
shot
