# Start: turns_declare_independence_ref's output.sav (France, Autumn 1600, turn 109, War of Independence
# declared; the Tories hold Montreal) with every French unit without orders fortified (land, orders 6) or
# sentried (ships, orders 1), and Guadeloupe (not a founding port) handed to the Crown
# (colony nation 2, the units on its tile too). France keeps Quebec, Martinique and Port au Prince: 3 colonies,
# 2 ports (Quebec, Port au Prince), crown share 57%.
# FUN_3844_0442 raw 58505-58556 (WoI declared, war not resolved): one @WARN%d a turn from the digit-patch
# selector, last write wins: ports (colonies with the founding coastal bit +0x1c 0x40) < 3 -> 1, crown share of
# the census colony population (c+1)*100/((h+1)+(c+1)) > 79 -> 3, census colonies < 3 -> 2; no lose arm
# (colonies 0 -> 2, share > 89 -> 3, ports 0 -> 1) fires.
# End of turn 109: a REF wave near Quebec and Tory fights near Guadeloupe (nested pump), then @WARN1 right after
# the calendar step, before the Indian pass (port_bugs.md #1387; shown every turn, no latch, #1392)
# ("the King's forces control all but 2 of the ports in New France!").
key space                # end turn 109 (Autumn 1600)
wait 30
key Return               # Royal Expeditionary Force lands near Quebec (nested pump)
wait 10
key Return               # nested pump
wait 10
key Return               # Rebel colonists CAPTURED by the Tory (nested pump)
wait 10
key Return               # Tories defeat Rebel Colonists near Guadeloupe (nested pump)
wait 10
key Return               # nested pump
wait 10
key Return               # Rebel colonists CAPTURED by the Tory (nested pump)
wait 10
key Return               # Tories defeat Rebel Colonists near Guadeloupe (nested pump)
wait 10
key Return               # @WARN1: all but 2 of the ports in New France
wait 10
key Return               # Iroquois gift of 11 Cotton to Port au Prince
wait 10
shot                     # Spring 1601
