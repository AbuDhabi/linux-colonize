# Start: a fixed fixture, not chained to europe_equip_units' current output: its six equipped units in this order (gold 59050) + one Jesuit Missionary specialist (@JOB 24) on the dock.
# Dock slots as loaded: 0 Dragoon, 1 Dragoon, 2 Pioneer, 3 Missionary (blessed colonist), 4 Soldier, 5 Scout, 6 Jesuit Missionary.
# Slot centres: 0-2 upper quay y 146 (x 241, 258, 275); 3-7 lower quay y 169 (x 241, 258, 275, 292, 309).
# Every way back goes through the same click menu (@ARMOPTIONS); each sell row refunds the gross price of the kit (untaxed).
# Rows (DOS omits non-applicable ones, [ToFront] on every slot but 0): Dragoon = NoBoard,[ToFront],SellMuskets,SellHorses,NoChanges;
# Soldier = ..,SellMuskets,BuyHorses,..; Scout = ..,BuyMuskets,SellHorses,..; Pioneer = ..,SellTools,..; blessed colonist = ..,Unbless,..
# A Pioneer / Missionary offers no row to switch kit directly (no muskets/horses/tools/bless rows): it must become a Colonist first.
key e                    # open the European Status screen
wait 10
click 241 146            # slot 0 Dragoon menu (4 rows: no ToFront on slot 0)
click 120 112            # Sell Horses: Dragoon -> Soldier
click 241 146            # slot 0 Soldier (4 rows)
click 120 100             # Sell Muskets: Soldier -> plain Colonist
click 258 146            # slot 1 Dragoon menu (5 rows)
click 120 106            # Sell Muskets: Dragoon -> Scout (stays a Scout)
click 275 146            # slot 2 Pioneer menu (4 rows)
click 120 112            # Sell Tools: Pioneer -> Colonist
click 275 146            # slot 2 Colonist menu (7 rows)
click 120 94             # Arm with Muskets: Colonist -> Soldier (the indirect Pioneer -> Soldier switch)
click 241 169            # slot 3 blessed colonist menu (4 rows)
click 120 112            # Unbless (drop the Missionary status): Missionary -> Colonist
click 241 169            # slot 3 Colonist menu (7 rows)
click 120 118            # Equip with Horses: Colonist -> Scout
click 258 169            # slot 4 Soldier menu (5 rows)
click 120 106            # Sell Muskets: Soldier -> Colonist
click 275 169            # slot 5 Scout menu (5 rows)
click 120 118            # Sell Horses: Scout -> Colonist
click 292 169            # slot 6 Jesuit menu: only NoBoard, ToFront, NoChanges (no Unbless for a born Missionary)
click 120 118            # No changes.
key e                    # leave Europe
