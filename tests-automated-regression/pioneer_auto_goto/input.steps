# divergences.pioneer_plan (settings.json). Hardy Pioneer 53 (100 tools) selected on (14,38).
key n     # VIEW Plan Pioneer on: View Pieces, cursor on the Pioneer's tile
key Right
key Right
key Down
key r     # plan a road on (16,39), two tiles away
key Left
key Left
key Up
shot
key n     # Plan Pioneer off, cursor back on the Pioneer
key a     # Activate it
key q     # ORDERS Automate: Go To (16,39) (order 3), paced one step this turn until the moves run out
wait 60
shot
